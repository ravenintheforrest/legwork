# Required only for live `discover` code search. Use a fine-grained public-repo read PAT.
GITHUB_TOKEN=

# Optional: enables live model-authored briefs. Without it, the evidence template is used.
ANTHROPIC_API_KEY=

# Optional provider switch: set to `cli` to use the local Claude CLI instead of the API.
LEGWORK_LLM=

# Optional outcome adapter. Fixture/demo mode needs no credentials.
HUBSPOT_TOKEN=

# Optional live-request policy dials (defaults: 3 concurrent, 5 requests/second).
# Fixture/demo mode ignores both — it makes no requests.
LEGWORK_HTTP_CONCURRENCY=
LEGWORK_HTTP_RPS=
